{
  "$defs": {
    "Diagnosis": {
      "enum": [
        "co_decline",
        "only_me",
        "season_weather",
        "undetermined"
      ],
      "title": "Diagnosis",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "description": "예: E01. 리포트 문장과 1:1 연결",
          "pattern": "^E\\d{2,}$",
          "title": "Claim Id",
          "type": "string"
        },
        "metric": {
          "description": "metrics 의 키",
          "title": "Metric",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "enum": [
            "pct",
            "pp",
            "count",
            "krw",
            "ratio"
          ],
          "title": "Unit",
          "type": "string"
        },
        "formula": {
          "description": "재계산 가능한 식(사람이 읽는 형태)",
          "title": "Formula",
          "type": "string"
        },
        "source_nos": {
          "description": "사용한 데이터 No. 목록. 점주 입력은 0",
          "items": {
            "type": "integer"
          },
          "title": "Source Nos",
          "type": "array"
        },
        "period": {
          "description": "예: 2026-08-17~2026-11-08 vs 전년 동기",
          "title": "Period",
          "type": "string"
        },
        "is_past_ref": {
          "default": false,
          "title": "Is Past Ref",
          "type": "boolean"
        }
      },
      "required": [
        "claim_id",
        "metric",
        "value",
        "unit",
        "formula",
        "source_nos",
        "period"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Freshness": {
      "additionalProperties": false,
      "properties": {
        "dataset_no": {
          "description": "제주데이터허브 목록 No.",
          "title": "Dataset No",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "last_obs_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Obs Date"
        },
        "unit": {
          "description": "예: 읍면동/일",
          "title": "Unit",
          "type": "string"
        },
        "used": {
          "title": "Used",
          "type": "boolean"
        },
        "reason": {
          "description": "사용/제외 사유",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "dataset_no",
        "name",
        "unit",
        "used",
        "reason"
      ],
      "title": "Freshness",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "current",
        "past_ref",
        "region_only"
      ],
      "title": "Mode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "default": "0.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "snapshot_id": {
      "description": "데이터 스냅샷 해시 앞 12자리(재현성)",
      "title": "Snapshot Id",
      "type": "string"
    },
    "data_freshness": {
      "items": {
        "$ref": "#/$defs/Freshness"
      },
      "title": "Data Freshness",
      "type": "array"
    },
    "metrics": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "visit_yoy_pct, my_orders_yoy_pct, rain_effect_pp …",
      "title": "Metrics",
      "type": "object"
    },
    "diagnosis": {
      "$ref": "#/$defs/Diagnosis"
    },
    "evidence_strength": {
      "enum": [
        "강",
        "중",
        "약"
      ],
      "title": "Evidence Strength",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "notes": {
      "description": "범위 축소·제외 사유 등",
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    }
  },
  "required": [
    "mode",
    "snapshot_id",
    "data_freshness",
    "metrics",
    "diagnosis",
    "evidence_strength",
    "evidence"
  ],
  "title": "AnalysisResult",
  "type": "object",
  "$id": "jeju-coach/analysis_result/0.1.0"
}
# 이 파일을 .env 로 복사한 뒤 필요한 값만 채우세요. (.env 는 절대 커밋·제출하지 않습니다)
# 키가 하나도 없어도 동작합니다: 데이터는 기준일 스냅샷(data/snapshot/), 조건 추출·리포트는 규칙 기반.
# 따옴표·앞뒤 공백 없이 `이름=값` 으로 적으세요.

# ── 실행 모드
COACH_MOCK=0          # 0: 실제 데이터(스냅샷·라이브) / 1: 가짜 지역 지표(개발·테스트용)
COACH_LIVE=0          # 1: 라이브 모드 — 점주 주문 기록 시기에 맞춰 동네 흐름을 API로 조회(아래 데이터 키 필요)
                      # 0: 기준일 스냅샷만 사용(키 불필요, 제출·재현 기본값)
COACH_LLM=0           # 1: LLM으로 조건 추출·리포트 문장 다듬기 / 0: 규칙 기반만(LLM 실패 시에도 자동으로 규칙 기반)

# ── 데이터 API 키 (라이브 모드·스냅샷 새로 만들 때만 필요)
JEJU_DATAHUB_KEY=     # 제주데이터허브(jejudatahub.net) 회원가입 → No.753·748 데이터 활용 신청 → 발급 키
DATA_GO_KR_API_KEY=   # 공공데이터포털(data.go.kr) → '기상청_지상(종관, ASOS) 일자료 조회서비스' 활용 신청 → 일반 인증키

# ── LLM (COACH_LLM=1 일 때만)
LLM_PROVIDER=gemini   # gemini | school(학교 AI챗, 미구현)
LLM_API_KEY=          # Google AI Studio API 키
LLM_MODEL=gemini-3.5-flash-lite
